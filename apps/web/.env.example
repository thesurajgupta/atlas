# ATLAS console — example environment for apps/web.
# Copy to .env.local and fill in LOCAL DEVELOPMENT values only.
# NEVER commit .env or .env.local (root .gitignore: .env.*).
#
# Everything named NEXT_PUBLIC_* is inlined into the browser bundle at build
# time. That is not a place for a secret: assume anyone with the page open can
# read it.

# ---- API ----
NEXT_PUBLIC_ATLAS_API=http://localhost:8000

# ---- Cash-out map basemap (/map) ----
# Google Maps JavaScript API key. Without it the page still renders and every
# panel keeps working; the map itself shows a "Google Maps unavailable" state
# naming this variable.
#
# The key is public by construction, so restrict it in the Google Cloud console
# before using it anywhere but localhost:
#   * Application restriction: HTTP referrers, limited to the console's origins.
#   * API restriction: Maps JavaScript API only.
# An unrestricted key on a public page is a key anyone can bill to your project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- MapLibre basemap (money-trail entity locator) ----
# A self-hosted MapLibre style document. Unset, the locator draws a coordinate
# graticule and requests nothing from anywhere, which is the default this
# repository ships (PUBLIC_REPOSITORY_SECURITY_BOUNDARY.md).
NEXT_PUBLIC_ATLAS_MAP_STYLE=
