# Copy to `.env.local` for local development.

# Basemap under the console's map markers. Three values:
#
#   <a style URL>  a self-hosted MapLibre style document. What a deployment
#                  should use — no coordinate leaves your infrastructure.
#   osm            OpenStreetMap raster tiles. No key and no account, real
#                  streets under the markers, and every pan sends a viewport to
#                  openstreetmap.org. Fine for a laptop demo; read their tile
#                  usage policy before pointing anything heavier at it:
#                  https://operations.osmfoundation.org/policies/tiles/
#   <unset>        a coordinate graticule and no imagery. The honest default
#                  for a public repository with an air-gapped deployment story.
NEXT_PUBLIC_ATLAS_MAP_STYLE=osm

# Where the API lives. Defaults to http://localhost:8000.
# NEXT_PUBLIC_ATLAS_API=http://localhost:8000
