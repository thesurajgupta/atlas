# ATLAS — example environment. Copy to .env and fill in LOCAL DEVELOPMENT values only.
# NEVER put real credentials in this file. NEVER commit .env. (ADR-010)

ATLAS_ENV=development                 # development | staging | production
ATLAS_LOG_LEVEL=INFO
ATLAS_TZ_DISPLAY=Asia/Kolkata          # storage is always UTC; this is presentation only

# ---- Database ----
ATLAS_DB_HOST=localhost
ATLAS_DB_PORT=5432
# Host-side ports (defaults avoid clashing with a local Postgres/Redis)
ATLAS_DB_PORT_HOST=55432
ATLAS_REDIS_PORT_HOST=56379
ATLAS_DB_NAME=atlas
ATLAS_DB_USER=atlas_app
ATLAS_DB_PASSWORD=change-me-locally
# Separate role with NO grant on the `truth` schema (spec §19.2)
ATLAS_FEATURE_DB_USER=atlas_features
ATLAS_FEATURE_DB_PASSWORD=change-me-locally

# ---- Redis (cache, rate limit, event bus — ADR-003) ----
ATLAS_REDIS_URL=redis://localhost:6379/0

# ---- Identity (ADR-006) ----
ATLAS_IDENTITY_PROVIDER=builtin        # builtin | keycloak
ATLAS_JWT_SECRET=generate-a-random-value-locally
ATLAS_ACCESS_TOKEN_TTL_SECONDS=900
ATLAS_REFRESH_TOKEN_TTL_SECONDS=86400
ATLAS_MFA_REQUIRED=true

# ---- Audit signing (ADR-007) ----
# In production this is a KMS/HSM key reference, never a file path.
ATLAS_AUDIT_SIGNING_KEY_PATH=./keys/audit-checkpoint.dev.key
ATLAS_AUDIT_CHECKPOINT_INTERVAL_SECONDS=300

# ---- Notifications: mock by default. Real providers fail closed if partly configured. ----
ATLAS_NOTIFICATION_PROVIDER=mock       # mock | email | sms | gov_gateway
ATLAS_ALLOW_EXTERNAL_NOTIFICATIONS=false

# ---- Prediction ----
ATLAS_H3_RESOLUTION=7                  # provisional; see ADR-011
ATLAS_PREDICTION_WINDOWS=6h,24h,72h
ATLAS_CANDIDATE_SET_CAP=500

# ---- Security ----
ATLAS_QUERY_BUDGET_PER_ANALYST_PER_DAY=500   # threat T-01, spec §35.1
ATLAS_RATE_LIMIT_PER_MINUTE=120
ATLAS_BREAK_GLASS_TTL_SECONDS=3600

# ---- Simulator (never used by the serving path — spec §19) ----
ATLAS_SIM_SEED=20260901
